# Examination Management Portal (EMP) - Environment Configuration Template
# Copy this file to .env and customize the values for your local environment:
#   cp .env.example .env

# Flask Application Settings
FLASK_APP=app.py
FLASK_ENV=development
FLASK_DEBUG=1

# Application Security Secret Key
# Generate a secure 32-byte secret key with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-secret-key

# Database Connection URI
# Default uses local SQLite file in instance/emp.db
DATABASE_URL=sqlite:///emp.db
